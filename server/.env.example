PORT=5000
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_ACCESS_EXP=15m
JWT_REFRESH_EXP=7d

# Email
EMAIL_PROVIDER=console
EMAIL_QUEUE_DRIVER=mongo
SENDGRID_API_KEY=
GITHUB_TOKEN=
GITHUB_STATS_TTL_HOURS=24
WORKER_CONCURRENCY=1
MAX_EMAIL_ATTEMPTS=5
GITHUB_REFRESH_BATCH=10
JOB_CRON_EXPR="0 * * * *"
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://localhost:27017/hkglug
# Docker: mongodb://mongo:27017/hkglug
MONGO_URI=mongodb://localhost:27017/hkglug

# Security
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=5
RATE_LIMIT_GUEST=5
